# Thin OS/Python glue only. Do not pip-install cellxgene-census, tiledbsoma,
# or any science stack here; those live in the project uv.lock + .venv.
# glibc (bookworm) is required so manylinux wheels from the lockfile load.

FROM python:3.11-slim-bookworm@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -LsSf https://astral.sh/uv/0.8.4/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Default workdir is bind-mounted PROJECT_DIR at runtime.
WORKDIR /work
