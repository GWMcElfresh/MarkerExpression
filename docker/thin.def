# Thin OS/Python glue only. Do not pip-install cellxgene-census, tiledbsoma,
# or any science stack here; those live in the project uv.lock + .venv.
# glibc (bookworm) is required so manylinux wheels from the lockfile load.
# Apptainer builds from this .def (not a Dockerfile).

Bootstrap: docker
# Digest-only: Apptainer rejects tag@digest in one From: line.
# Digest pins python:3.11-slim-bookworm.
From: python@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91

%post
    set -euo pipefail
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl
    curl -LsSf https://astral.sh/uv/0.8.4/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh
    apt-get purge -y curl
    apt-get autoremove -y
    rm -rf /var/lib/apt/lists/*
