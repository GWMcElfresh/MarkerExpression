# Canonical SLURM resource table for MarkerExpression wrappers.
# Units: TIME=HH:MM:SS, MEM=SLURM memory string, CPUS=integer.

# Prep: thin SIF build/pull (batch CPU)
THIN_SIF_TIME="${THIN_SIF_TIME:-2:00:00}"
THIN_SIF_CPUS="${THIN_SIF_CPUS:-2}"
THIN_SIF_MEM="${THIN_SIF_MEM:-8G}"

# Prep: uv sync into project .venv inside thin SIF (batch CPU)
PY_VENV_TIME="${PY_VENV_TIME:-1:00:00}"
PY_VENV_CPUS="${PY_VENV_CPUS:-2}"
PY_VENV_MEM="${PY_VENV_MEM:-8G}"

# Stage: Census stream + percent tables (batch CPU; network I/O bound)
SUMMARIZE_TIME="${SUMMARIZE_TIME:-8:00:00}"
SUMMARIZE_CPUS="${SUMMARIZE_CPUS:-8}"
SUMMARIZE_MEM="${SUMMARIZE_MEM:-64G}"

# Optional Apptainer build extras (e.g. --fakeroot on permission errors).
ARC_APPTAINER_BUILD_ARGS="${ARC_APPTAINER_BUILD_ARGS:-}"
